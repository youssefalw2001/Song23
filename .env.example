# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Which music backend to use.
#   acemusic   - ACE Music's free hosted ACE-Step 1.5 (api.acemusic.ai)
#   selfhosted - your own ACE-Step 1.5 server (no gateway timeout, wav output)
MUSIC_PROVIDER=acemusic

# --- acemusic provider ------------------------------------------------------
# Get a key (free) at https://acemusic.ai/playground/api-key
ACE_API_KEY=
ACE_BASE_URL=https://api.acemusic.ai

# `thinking` runs ACE's 5Hz planning LM before generation. It may improve
# musicality, but on the hosted endpoint it reliably blows the 60s Cloudflare
# timeout and returns 504. Measured: thinking=false generates a 180s song in
# ~21s; thinking=true 504s at 60s even for a 30s song. Leave this false unless
# you are pointing at your own server.
ACE_THINKING=false

# --- selfhosted provider ----------------------------------------------------
# Your ACE-Step 1.5 api_server. Native async mode, so no timeout ceiling.
SELFHOSTED_BASE_URL=http://127.0.0.1:8001
SELFHOSTED_API_KEY=
SELFHOSTED_MODEL=
# Self-hosting removes the 128kbps ceiling. wav or flac for a paid deliverable.
SELFHOSTED_AUDIO_FORMAT=wav

# --- service ----------------------------------------------------------------
PORT=8787

# Bearer token the /studio page must send. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# OPTIONAL. Leave it blank and the service accepts requests from anyone — which
# is reasonable on localhost, and a data leak on a public URL, because `data/`
# holds customers' emails and everything they wrote about their pet. Setting it
# later needs nothing but this variable and a restart.
OPERATOR_TOKEN=

# Comma-separated origins allowed to call this service from a browser.
# The site is a static export, so it calls this from the browser and needs CORS.
ALLOWED_ORIGINS=http://localhost:3000,https://youssefalw2001.github.io

# Where jobs, lyrics and audio are written.
DATA_DIR=./data
